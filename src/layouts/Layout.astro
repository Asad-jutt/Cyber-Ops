---
import '../index.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Cyber Ops // Zero-Trust Cybersecurity Consulting",
  description = "Enterprise Cybersecurity Consulting, Offensive Threat Audits, Autonomous SOC Intelligence, and Quantum-Resistant Defense Architecture."
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <script is:inline>
      // Global runtime guards and polyfills
      (function() {
        try {
          if (typeof window !== 'undefined') {
            if (!window.process) {
              window.process = { env: {}, emit: function() {}, on: function() {}, addListener: function() {}, removeListener: function() {} };
            } else {
              if (typeof window.process.emit !== 'function') window.process.emit = function() {};
              if (typeof window.process.on !== 'function') window.process.on = function() {};
              if (typeof window.process.addListener !== 'function') window.process.addListener = function() {};
              if (typeof window.process.removeListener !== 'function') window.process.removeListener = function() {};
            }
          }

          if (typeof window !== 'undefined' && window.matchMedia) {
            var origMatchMedia = window.matchMedia;
            window.matchMedia = function(query) {
              var mql = origMatchMedia.call(window, query);
              if (mql) {
                if (typeof mql.addListener !== 'function') {
                  mql.addListener = function(cb) {
                    try { mql.addEventListener('change', cb); } catch (err) {}
                  };
                }
                if (typeof mql.removeListener !== 'function') {
                  mql.removeListener = function(cb) {
                    try { mql.removeEventListener('change', cb); } catch (err) {}
                  };
                }
              }
              return mql;
            };
          }

          if (typeof window !== 'undefined' && window.screen) {
            if (!window.screen.orientation) {
              window.screen.orientation = {
                type: 'landscape-primary',
                angle: 0,
                addEventListener: function() {},
                removeEventListener: function() {},
                addListener: function() {},
                removeListener: function() {},
                onchange: null
              };
            } else {
              if (typeof window.screen.orientation.addListener !== 'function') {
                window.screen.orientation.addListener = function(cb) {
                  try { window.screen.orientation.addEventListener('change', cb); } catch (e) {}
                };
              }
              if (typeof window.screen.orientation.removeListener !== 'function') {
                window.screen.orientation.removeListener = function(cb) {
                  try { window.screen.orientation.removeEventListener('change', cb); } catch (e) {}
                };
              }
            }
          }
        } catch (e) {}

        window.addEventListener('error', function(e) {
          if (e && e.message && (
            e.message.includes('ethereum') ||
            e.message.includes('emit') ||
            e.message.includes('addListener')
          )) {
            e.preventDefault();
            e.stopImmediatePropagation();
          }
        }, true);
      })();
    </script>
  </head>
  <body class="bg-[#0b0f19] text-white selection:bg-cyan-500/30 selection:text-cyan-300 font-sans overflow-x-hidden min-h-screen">
    <slot />
  </body>
</html>
